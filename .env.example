# Server address. 0.0.0.0 listens on all interfaces, so the app is reachable by anyone on your network;
# use 127.0.0.1 to allow local access only.
HOST=0.0.0.0
PORT=8000

# Jira credentials only (optional; without them the Jira panel is hidden).
# JQL / filter and the estimate field are chosen in the web UI by the room owner.
JIRA_BASE_URL=https://your-company.atlassian.net
# Cloud: account email + API token (https://id.atlassian.com/manage-profile/security/api-tokens)
# Server/DC: leave JIRA_EMAIL empty and put a Personal Access Token in JIRA_TOKEN
JIRA_EMAIL=you@company.com
JIRA_TOKEN=
# cloud | server  (server = Jira Server/Data Center)
JIRA_FLAVOR=cloud
# Optional default for the JQL field: a saved filter id (12345) or any JQL (filter = 12345, assignee = currentUser())
JIRA_DEFAULT_FILTER=
